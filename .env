# Azure Sentinel DevOps Orchestrator Configuration

# Fabric IQ Configuration
FABRIC_WORKSPACE=devops_orchestration
FABRIC_EVENTHOUSE=devops_telemetry

# Foundry IQ Configuration
FOUNDRY_MODEL=gpt-4o-reasoning
